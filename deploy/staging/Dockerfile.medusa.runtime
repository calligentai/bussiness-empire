# Prebuilt Medusa server (.medusa/server with production node_modules).
# The iMac does not run npm for this image. Orders are in Postgres, not in this image.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY . .
EXPOSE 9000
CMD ["sh", "-c", "npx medusa db:migrate && npx medusa exec ./src/scripts/seed.ts && if [ -n \"$MEDUSA_ADMIN_EMAIL\" ] && [ -n \"$MEDUSA_ADMIN_PASSWORD\" ]; then npx medusa user -e \"$MEDUSA_ADMIN_EMAIL\" -p \"$MEDUSA_ADMIN_PASSWORD\" || true; fi && exec npx medusa start"]
