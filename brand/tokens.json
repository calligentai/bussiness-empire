{
  "meta": {
    "name": "Lava Bean",
    "version": "1.0.0",
    "description": "Single source of truth for Lava Bean colour, type, spacing, grid, breakpoints and motion."
  },
  "color": {
    "ink": "#141210",
    "paper": "#F4F0EA",
    "lava": "#E2481B",
    "ember": "#F2A03D",
    "muted": "#6B625B",
    "surface": "#2A2522",
    "line": "#D9D2C7",
    "white": "#FFFFFF",
    "danger": "#B3261E",
    "success": "#1E6B45"
  },
  "colorPairs": [
    { "foreground": "ink", "background": "paper", "minimum": "AA", "usage": "body" },
    { "foreground": "muted", "background": "paper", "minimum": "AA", "usage": "secondary" },
    { "foreground": "paper", "background": "surface", "minimum": "AA", "usage": "inverted body" },
    { "foreground": "paper", "background": "ink", "minimum": "AA", "usage": "header" },
    { "foreground": "ink", "background": "ember", "minimum": "AA", "usage": "primary action" },
    { "foreground": "ember", "background": "ink", "minimum": "AA", "usage": "accent text" },
    { "foreground": "white", "background": "danger", "minimum": "AA", "usage": "error" },
    { "foreground": "lava", "background": "paper", "minimum": "AA-large", "usage": "display accent" },
    { "foreground": "white", "background": "lava", "minimum": "AA-large", "usage": "display on lava" }
  ],
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "typography": {
    "family": {
      "display": "\"Space Grotesk\", \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif",
      "body": "\"Inter\", \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"IBM Plex Mono\", \"SFMono-Regular\", Menlo, monospace"
    },
    "size": {
      "100": "12px",
      "200": "14px",
      "300": "16px",
      "400": "20px",
      "500": "26px",
      "600": "34px",
      "700": "46px",
      "800": "64px"
    },
    "lineHeight": {
      "tight": "1.1",
      "display": "1.2",
      "body": "1.6"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "bold": "700"
    },
    "tracking": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.08em"
    }
  },
  "radius": {
    "0": "0px",
    "sm": "6px",
    "md": "12px",
    "pill": "999px"
  },
  "border": {
    "hairline": "1px",
    "strong": "2px"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "marginMobile": "16px",
    "marginDesktop": "48px",
    "maxWidth": "1200px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
