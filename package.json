{
  "name": "lavabean-brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "tokens:build": "node scripts/build-tokens.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "test": "vitest run",
    "test:brand": "vitest run tests/brand-rules.test.ts",
    "test:incident-worktree": "node --test tests/incident-worktree.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm tokens:build && pnpm brand:check && pnpm test && pnpm build && pnpm build-storybook && playwright test",
    "test:e2e:update": "pnpm build && playwright test --update-snapshots",
    "prepare": "nuxt prepare",
    "pretest": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "3.15.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/vue3": "^8.6.19",
    "@storybook/vue3-vite": "^8.6.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "storybook": "^8.6.14",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
