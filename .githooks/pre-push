#!/usr/bin/env bash
# Last gate before code leaves the machine. Checks the tree being pushed (HEAD),
# not the working copy, so `git commit --no-verify` can't slip a broken tree through.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git -C "$root" archive HEAD | tar -x -C "$tmp"
"$tmp/verify.sh"
