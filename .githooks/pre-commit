#!/usr/bin/env bash
# Auto-CI: refuses the commit if a recorded doc hash, a test or the build fails.
# Checks an export of the index, so the result covers exactly what gets committed.
set -euo pipefail
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git checkout-index --all --ignore-skip-worktree-bits --prefix="$tmp/"
"$tmp/verify.sh"
