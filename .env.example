# Copy to .env on the server. Never commit filled secrets.
APP_ENV=staging
APP_REVISION=
ORDER_DATA_DIR=/data/orders
PAYMENT_PROVIDER=manual

# This build does not call Stripe, Mollie, or Medusa.
# PAYMENT_PROVIDER=stripe refuses checkout until a Stripe client exists.
# PAYMENT_PROVIDER=mollie refuses checkout until a Mollie client exists.
# A key beginning with sk_live_, rk_live_, or live_ is refused in every mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MOLLIE_API_KEY=
# MEDUSA_BACKEND_URL=
# MEDUSA_PUBLISHABLE_KEY=
