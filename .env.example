# Copy to the server environment. Never commit filled secrets.
APP_ENV=staging
APP_REVISION=
PAYMENT_PROVIDER=manual
MEDUSA_BACKEND_URL=http://medusa:9000

# Required on the iMac. Generate them there. Do not paste real values into git.
MEDUSA_DB_PASSWORD=
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
LAVABEAN_INTERNAL_TOKEN=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# The publishable key is written by the Medusa seed onto the medusa volume.
# MEDUSA_PUBLISHABLE_KEY_FILE=/seed/seed-state.json

# Stripe and Mollie are not called. Live keys are refused.
# PAYMENT_PROVIDER=stripe returns 501 until a Stripe client exists.
# PAYMENT_PROVIDER=mollie returns 501 until a Mollie client exists.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MOLLIE_API_KEY=
